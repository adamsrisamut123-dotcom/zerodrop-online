# Railway supplies PORT automatically. Keep it unset on Railway.
PORT=3000
ROOM_TTL_MINUTES=60
MAX_FILE_MB=25
MAX_ROOM_MB=100
MAX_TOTAL_MB=250
# Set TRUST_PROXY=1 only behind a proxy you control which overwrites X-Forwarded-For.
TRUST_PROXY=0
# Optional, set to your actual https://your-domain for correct QR URLs on some proxies
# PUBLIC_BASE_URL=https://your-app.up.railway.app
